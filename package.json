{
  "name": "glasswing",
  "productName": "Glasswing",
  "version": "1.0.0",
  "description": "A minimalist, dark, see-through browser with floating controls, split view, built-in ad and tracker blocking, and Chrome extension support.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "electron test/smoke.js",
    "dist": "electron-builder --win --publish never",
    "predist": "node build/patch-installer.js"
  },
  "keywords": [
    "browser",
    "electron"
  ],
  "author": "Sl0oth",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sl0oth.glasswing",
    "productName": "Glasswing",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Glasswing-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glasswing",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sl0oth",
        "repo": "Glasswing"
      }
    ]
  }
}
